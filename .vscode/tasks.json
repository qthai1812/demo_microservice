{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Infrastructure",
      "type": "shell",
      "command": "docker compose -f docker-compose.infra.yml up -d",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared",
        "group": "infra"
      },
      "problemMatcher": []
    },
    {
      "label": "Stop Infrastructure",
      "type": "shell",
      "command": "docker compose -f docker-compose.infra.yml down",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "identity-service",
      "type": "shell",
      "command": "./mvnw spring-boot:run",
      "options": { "cwd": "${workspaceFolder}/identity-service" },
      "isBackground": true,
      "presentation": { "echo": true, "reveal": "always", "panel": "dedicated", "group": "services", "showReuseMessage": false },
      "problemMatcher": [{ "pattern": { "regexp": "^$" }, "background": { "activeOnStart": true, "beginsPattern": "^.*Starting.*$", "endsPattern": "^.*Started.*in.*seconds.*$" } }]
    },
    {
